{
  "name": "coderoom",
  "version": "0.1.0",
  "private": true,
  "description": "CodeRoom — collaborative coding & interview platform",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:tests": "node prisma/seed-testcases.mjs",
    "test:phase4": "node scripts/test-phase4.mjs",
    "test:phase5": "node scripts/test-phase5.mjs",
    "test:phase6": "node scripts/test-phase6.mjs",
    "test:phase8": "node scripts/test-phase8.mjs",
    "test:phase9": "node scripts/test-phase9.mjs",
    "test:phase10": "node scripts/test-phase10.mjs",
    "test:phase11": "node scripts/test-phase11.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.16.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.1.0",
    "nanoid": "^5.1.16",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
