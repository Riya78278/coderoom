# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit your real .env — it contains secrets.

# ——— Database (Neon Postgres) ———
# Create a free project at https://neon.tech → copy the connection string here.
DATABASE_URL=""

# ——— Auth ———
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# ——— Real-time broadcast (Phase 6) ———
# Shared secret for the internal Socket.IO broadcast bridge. Generate it the
# same way as AUTH_SECRET. In development a safe default ("dev-internal") is
# used automatically, so you can leave this empty locally.
INTERNAL_BROADCAST_SECRET=""

# ——— Code execution (Phase 6) ———
# "judge0" (default — public CE, no key needed) or "piston".
EXECUTION_BACKEND="judge0"
# Only needed if you switch to a self-hosted or paid Judge0:
# JUDGE0_URL="https://ce.judge0.com"
# JUDGE0_KEY=""
